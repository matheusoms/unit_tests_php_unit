{
    "name": "fatec/php-crud-q1",
    "description": "CRUD PHP com testes unitários - Quadrante Q1 dos Testes Ágeis",
    "type": "project",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test:coverage": "vendor/bin/phpunit --coverage-text",
        "test:verbose": "vendor/bin/phpunit --verbose"
    }
}
